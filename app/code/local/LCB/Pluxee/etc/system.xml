<?xml version="1.0"?>
<config>
    <tabs>
        <lcbrq translate="label" module="lcb_pluxee">
            <label>LCBRQ</label>
            <sort_order>1200</sort_order>
        </lcbrq>
    </tabs>
    <sections>
        <pluxee translate="label" module="lcb_pluxee">                    
            <label>Pluxee</label>
            <tab>lcbrq</tab>
            <frontend_type>text</frontend_type>
            <sort_order>999</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>0</show_in_website>
            <show_in_store>0</show_in_store>            
            <groups>
                <api translate="label"> 
                    <label>API</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>0</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <endpoint>
                            <label>Endpoint</label>
                            <frontend_type>text</frontend_type>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <sort_order>1</sort_order>
                        </endpoint>
                        <username translate="label">
                            <label>Username</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                        </username>
                        <password translate="label">
                            <label>Password</label>
                            <frontend_type>obscure</frontend_type>
                            <backend_model>adminhtml/system_config_backend_encrypted</backend_model>
                            <sort_order>2</sort_order>
                            <show_in_default>1</show_in_default>
                        </password>
                        <login translate="label comment">
                            <frontend_type>button</frontend_type>
                            <frontend_model>lcb_pluxee/adminhtml_system_config_form_loginButton</frontend_model>
                            <sort_order>3</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </login>
                    </fields>
                </api>
                <limit translate="label">
                    <label>Limit</label>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <sort_order>1</sort_order>
                    <frontend_type>text</frontend_type>
                    <fields>
                        <user_daily>
                            <label>User daily limit</label>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <frontend_type>text</frontend_type>
                            <validate>validate-digits</validate>
                            <sort_order>10</sort_order>
                        </user_daily>
                        <general_daily>
                            <label>General daily limit</label>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <frontend_type>text</frontend_type>
                            <sort_order>20</sort_order>
                            <validate>validate-digits</validate>
                        </general_daily>
                    </fields>
                </limit>
                <log>
                    <label>Log</label>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <sort_order>3</sort_order>
                    <fields>
                        <enable translate="label">
                            <label>Enable</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>4</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </enable>
                    </fields>
                </log>
                <cards_topup translate="label" module="lcb_pluxee">
                    <label>Cards and Top-Up</label>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <sort_order>4</sort_order>
                    <frontend_type>text</frontend_type>
                    <fields>
                        <magnetic_card_id translate="label">
                            <label>Pluxee Magnetic Card ID</label>
                            <frontend_type>select</frontend_type>
                            <source_model>lcb_pluxee/system_config_source_product</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </magnetic_card_id>
                        <magnetic_topup_id translate="label">
                            <label>Pluxee Magnetic Topup ID</label>
                            <frontend_type>select</frontend_type>
                            <source_model>lcb_pluxee/system_config_source_product</source_model>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </magnetic_topup_id>
                        <virtual_card_id translate="label">
                            <label>Pluxee Virtual Card ID</label>
                            <frontend_type>select</frontend_type>
                            <source_model>lcb_pluxee/system_config_source_product</source_model>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </virtual_card_id>
                        <virtual_topup_id translate="label">
                            <label>Pluxee Virtual Topup ID</label>
                            <frontend_type>select</frontend_type>
                            <source_model>lcb_pluxee/system_config_source_product</source_model>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </virtual_topup_id>
                    </fields>
                </cards_topup>
                <order translate="label">
                    <label>Order</label>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <sort_order>5</sort_order>
                    <frontend_type>text</frontend_type>
                    <fields>
                        <email_template>
                            <label>Email Template</label>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_email_template</source_model>
                            <sort_order>1</sort_order>
                        </email_template>
                    </fields>
                </order>
            </groups>
        </pluxee>
    </sections>
</config>
